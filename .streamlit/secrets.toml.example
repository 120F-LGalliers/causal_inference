# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste into the hosted app's Secrets
# settings. Never commit real keys.

[monetate.dominos]
retailer = "dominos"            # retailer shortname used in Monetate API URLs (ask Monetate if unsure)
username = "your-api-username"  # shown in Monetate when the API key is created
private_key = """-----BEGIN PRIVATE KEY-----
paste the private key here
-----END PRIVATE KEY-----"""
